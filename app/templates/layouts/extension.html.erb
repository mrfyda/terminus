<!DOCTYPE html>

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

    <title><%= content_for :title %></title>

    <meta charset="utf-8">
    <meta name="description" content="A TRMNL server.">
    <meta name="author" content="TRMNL">

    <%= tag.link title: "TRMNL: Stylesheet",
                 rel: :stylesheet,
                 href: "https://trmnl.com/css/latest/plugins.css" %>

    <style type="text/css">
      /* The screenshot viewport is exactly the model's pixel dimensions, so the
       * design has to be centered against the full viewport. Since the main
       * axis is vertical, justify-content needs a body that is as tall as the
       * viewport -- body defaults to content height, which left it with no free
       * space to distribute and rendered a 460px design flush to the top of a
       * 758px screen.
       *
       * Physical properties only. Aspects::Sanitizer runs over this markup
       * before the screenshot and drops any CSS property outside its allow
       * list, which covers height and min-height but not min-block-size. Using
       * the logical properties silently lost the vertical rule while keeping
       * align-items, which centered horizontally and rendered flush to the
       * top. */
      :where(html) {
        height: 100%;
      }

      :where(body) {
        align-items: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100%;
      }

      .screen {
        <%= content_for :screen_variables %>
      }
    </style>

    <%= javascript_tag "https://trmnl.com/js/latest/plugins.js" %>
  </head>

  <body class="trmnl">
    <%= yield %>
  </body>
</html>

